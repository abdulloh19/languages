# Tilsevar Service Configuration Example
# Telegram Bot Token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Public URL for Telegram Mini App (e.g. Cloudflare tunnel or production URL)
WEBAPP_URL=https://your-domain-or-tunnel.trycloudflare.com

# Database Connection URL:
# For local SQLite: sqlite:///./tilsevar.db
# For production PostgreSQL: postgresql://username:password@localhost:5432/tilsevar
DATABASE_URL=sqlite:///./tilsevar.db

# API Server Port
PORT=8085
